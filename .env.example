# ==========================================
# SkyCast Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Security & CORS (Set your production Vercel URL in Render dashboard)
# Multiple origins can be comma-separated: https://skycast.vercel.app,http://localhost:5173
CORS_ORIGIN=https://skycast.vercel.app

# MongoDB Atlas Connection
# Replace with your Atlas connection string; dbName 'skycast' is automatically enforced
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-domain>.mongodb.net/skycast?retryWrites=true&w=majority

# Authentication JWT Configuration
JWT_SECRET=generate_a_long_random_64_char_secret_key_here
JWT_EXPIRES_IN=7d

# Weather API Providers
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEO_URL=https://geocoding-api.open-meteo.com/v1
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1

# Secondary / Fallback Weather Provider (WeatherAPI.com - 1M free calls/month)
# Add your free WeatherAPI key to activate fallback when Open-Meteo limit is reached
WEATHERAPI_KEY=a1083d13af5c474aa9b193817260111
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1

# In-Memory Cache TTL (Minutes)
CACHE_TTL_MINUTES=15
