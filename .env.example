# Server Configuration
PORT=5000
NODE_ENV=development

# Security
CORS_ORIGIN=http://localhost:5173

# Database (For Phase 3 & TTL Caching)
MONGODB_URI=mongodb://127.0.0.1:27017/skycast

# Authentication (For Phase 3)
JWT_SECRET=super_secret_jwt_key_skycast_dev_mode_change_in_production
JWT_EXPIRES_IN=7d

# Weather API Integrations
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEO_URL=https://geocoding-api.open-meteo.com/v1
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1

# Cache Configuration
CACHE_TTL_MINUTES=15

